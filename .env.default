# Discourse 对外访问的域名，不包含端口；用于 database.yml 的 host_names 等域名匹配
DISCOURSE_DOMAIN=discourse.rs.com

# Docker web容器对外暴露端口；例如 80:80、13000:80 中左侧的端口
DISCOURSE_EXTERNAL_PORT=80

# 浏览器地址栏中用户实际访问的 Host；标准 80 端口不写 :80，非标准端口才写，如 discourse.rs.com:13000
DISCOURSE_HOSTNAME=discourse.rs.com

# 管理员账号
DISCOURSE_DEVELOPER_EMAILS=admin@example.com
# 管理员默认密码；仅首次创建管理员、管理员无密码、或 RESET_ADMIN_PASSWORD=true 时生效
DISCOURSE_ADMIN_PASSWORD=Admin@1234567890
# 是否强制重置管理员密码；默认 false，避免每次重启覆盖页面中修改过的密码
RESET_ADMIN_PASSWORD=false